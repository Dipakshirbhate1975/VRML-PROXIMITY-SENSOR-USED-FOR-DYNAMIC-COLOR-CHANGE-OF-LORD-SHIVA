DEF Light1 PointLight {
 ambientIntensity 0.000
 intensity 1.000
 radius 5.000
 attenuation 1 0 0
 color 1 1 1
 on TRUE
}
ROUTE PROX_SENSOR.enterTime TO TIME.startTime
ROUTE TIME.fraction_changed TO INTERP_COLOR.set_fraction
ROUTE INTERP_COLOR.value_changed TO A__16.set_diffuseColor
ROUTE PROX_SENSOR.exitTime TO TIME.stopTime
